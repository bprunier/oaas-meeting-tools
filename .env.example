# ─────────────────────────────────────────────────────────────────────────────
# CONFIG GLOBALE — s'applique à tous les projets
# Copiez ce fichier en .env et ajustez les valeurs
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode projet ───────────────────────────────────────────────────────────────
# Les données (BDD, ChromaDB) sont stockées dans projects/<nom>/
# Les chemins DB_PATH et CHROMA_PATH sont gérés automatiquement.
#
# Commandes :
#   python main.py project create <nom>   # créer un projet
#   python main.py project use <nom>      # activer un projet
#   python main.py project list           # lister les projets
#   python main.py --project <nom> <cmd>  # forcer un projet pour une commande
#
# Chaque projet peut surcharger les variables ci-dessous via projects/<nom>/.env

# ── Whisper (transcription) ───────────────────────────────────────────────────
# Taille du modèle : tiny | base | small | medium | large-v3
# large-v3 recommandé pour le français
WHISPER_MODEL_SIZE=large-v3

# Langue audio (laisser vide pour auto-détection)
AUDIO_LANGUAGE=fr

# ── Diarisation / VAD ─────────────────────────────────────────────────────────
# Temps de parole minimum (secondes) pour inclure un locuteur dans la synthèse
MIN_SPEAKING_TIME=5

# Seuil VAD : dB sous le pic pour détecter le silence (défaut: 35)
# Baisser (ex: 20) pour capter les voix faibles ou courtes interventions
VAD_TOP_DB=35

# ── Ollama (LLM local — sentiment, résumé, RAG) ───────────────────────────────
# Installer : https://ollama.com  puis : ollama pull llama3
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Embeddings RAG (100% local via Ollama) ────────────────────────────────────
# Puller d'abord : ollama pull nomic-embed-text
# Alternatives françaises :
#   ollama pull mxbai-embed-large   (meilleur multilingue, ~670 MB)
#   ollama pull bge-m3              (excellent français, ~1.2 GB)
EMBEDDING_MODEL=nomic-embed-text

# Nombre de segments récupérés par défaut pour `ask` (surchargeable via --top-k)
RAG_TOP_K=100
